{
  "name": "sculptsdk-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.11 <23",
    "pnpm": ">=10.0.0 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --filter @sculptsdk/core build && pnpm --filter @sculptsdk/adapter-testing build && pnpm --filter @sculptsdk/adapter-playwright build",
    "typecheck": "pnpm run build && pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixtures:build": "pnpm --filter @sculptsdk/fixtures build",
    "fixtures:serve": "node packages/fixtures/server.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sculptsdk/adapter-playwright": "workspace:*",
    "@sculptsdk/adapter-testing": "workspace:*",
    "@sculptsdk/core": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.24.2",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
