    "@sculptsdk/core": "workspace:*"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "typescript": "^5.6.3"
  }
