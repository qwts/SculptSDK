{
  "name": "@sculptsdk/adapter-playwright",
  "version": "0.1.0",
  "description": "SculptSDK runtime adapter for Playwright pages",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
